# ============================================================
# 丹青有AI 后端 - 生产环境配置模板
# 使用方法:复制为 .env 并填入真实值
# 严禁提交含真实密钥的 .env 到 git
# ============================================================

# ---------- 飞书 OAuth(填入真实应用凭证) ----------
FEISHU_APP_ID=cli_your_production_app_id
FEISHU_APP_SECRET=your_production_app_secret
FEISHU_REDIRECT_URI_WEB=https://your-domain.com/auth/feishu/callback
FEISHU_REDIRECT_URI_ADMIN=https://admin.your-domain.com/auth/feishu/callback
FEISHU_REDIRECT_URI_MOBILE=https://your-domain.com/auth/feishu/callback
FEISHU_AUTHZ_ENDPOINT=https://open.feishu.cn/open-apis/authen/v1/authorize
FEISHU_TOKEN_ENDPOINT=https://open.feishu.cn/open-apis/authen/v1/oidc/access_token
FEISHU_USERINFO_ENDPOINT=https://open.feishu.cn/open-apis/authen/v1/user_info

# ---------- JWT 密钥(生产环境必须重新生成) ----------
# 生成命令:openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"
JWT_KEY_ID=danqing-ai-prod-2026
JWT_ISSUER=danqing-ai-auth
JWT_AUDIENCE_WEB=danqing-ai-web
JWT_AUDIENCE_ADMIN=danqing-ai-admin
JWT_AUDIENCE_MOBILE=danqing-ai-mobile
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---------- Cookie / CSRF(生产环境必须开启 Secure) ----------
COOKIE_SECURE=true
COOKIE_DOMAIN=.your-domain.com
COOKIE_SAMESITE=strict
COOKIE_PATH=/auth
COOKIE_MAX_AGE=604800

# ---------- 基础设施 ----------
# PostgreSQL:使用强密码,非默认端口可增加安全性
# connection_limit=10 限制连接池上限避免耗尽;pool_timeout=10s 获取连接超时快速失败
DATABASE_URL=postgresql://danqing:STRONG_PASSWORD_HERE@127.0.0.1:5432/danqing_ai?schema=public&connection_limit=10&pool_timeout=10
# Redis:生产环境设置密码
REDIS_URL=redis://:REDIS_PASSWORD_HERE@127.0.0.1:6379

# ---------- CORS 白名单(仅允许正式域名) ----------
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# ---------- 限流(生产环境收紧) ----------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_CALLBACK_PER_MIN=5
RATE_LIMIT_REFRESH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=60

# ---------- 租户默认值 ----------
TENANT_DEFAULT_PLAN=free
TENANT_DEFAULT_TYPE=individual

# ---------- 安全与环境 ----------
ENABLE_HSTS=true
LOG_LEVEL=info
NODE_ENV=production
PORT=3000

# ---------- 开发模式(生产环境必须为 false) ----------
DEV_SKIP_AUTH=false

# ---------- 文件上传 ----------
# COS挂载路径:轻量对象存储已挂载到 /lhcos-data,上传文件存储到其下 uploads 子目录
UPLOAD_DIR=/lhcos-data/uploads
UPLOAD_MAX_SIZE=10485760

# ---------- AI 视觉分析(支持任意 OpenAI 兼容 API 端点) ----------
# 说明:AI 模块采用 OpenAI 兼容协议,可接入任意兼容端点(GLM / TRAE / OpenAI / Azure / vLLM 等)
# 配置流程:
#   1. 在下方填入 AI_API_KEY / AI_API_URL / AI_API_MODEL
#   2. 设置 AI_ENABLED=true 启用 AI 分析
#   3. 重启 PM2:pm2 restart danqing-api
#   4. 验证:调用 GET /api/admin/system/ai-config 查看配置状态
#   5. 测试:调用 POST /api/admin/system/ai-config/test 验证连通性
#
# 支持的 Provider 示例(任选其一):
#
# [智谱 GLM-4V] 免费 10 RPM,推荐复赛使用
#   AI_PROVIDER=glm
#   AI_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
#   AI_API_MODEL=glm-4v-flash
#   AI_API_KEY=<到 https://open.bigmodel.cn/usercenter/apikeys 申请>
#
# [OpenAI] 付费
#   AI_PROVIDER=glm
#   AI_API_URL=https://api.openai.com/v1/chat/completions
#   AI_API_MODEL=gpt-4o-mini
#   AI_API_KEY=sk-...
#
# [Azure OpenAI] 付费
#   AI_PROVIDER=glm
#   AI_API_URL=https://{resource}.openai.azure.com/openai/deployments/{deploy}/chat/completions?api-version=2024-08-01-preview
#   AI_API_MODEL=gpt-4o
#   AI_API_KEY=<Azure 部署密钥>
#
# [自部署 vLLM] 自建 GPU 推理服务
#   AI_PROVIDER=glm
#   AI_API_URL=http://your-host:8000/v1/chat/completions
#   AI_API_MODEL=llava-v1.5-7b
#   AI_API_KEY=EMPTY  (vLLM 默认不校验)
#
# [TRAE 内置 AI] 需补全 TRAE_API_KEY + TRAE_API_URL,见下方 TRAE 节
#   AI_PROVIDER=trae
AI_ENABLED=true
AI_PROVIDER=glm
# AI_API_KEY:留空时 AI_ENABLED=true 也会自动 fallback 到模板规则(不影响业务流程)
# 请填入真实 Key 后重启 PM2 生效
AI_API_KEY=your_glm_api_key_here
AI_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# AI_API_TIMEOUT:硬性 2500ms,保障 3 秒 SLA(上传→看到分数<3 秒),不建议调大
# 双层超时保障(P3-2.2):axios timeout + AbortController wall-clock deadline,任一触发即走 Jimp fallback
AI_API_TIMEOUT=2500
# AI_API_MODEL:glm-4v-flash 免费 / glm-4v-plus 付费高精度
AI_API_MODEL=glm-4v-flash

# ---------- TRAE AI 服务配置(可选,留空时自动降级到 GLM) ----------
# 仅当 AI_PROVIDER=trae 时生效;TRAE 凭证不完整时自动降级到 GLM
TRAE_API_KEY=
TRAE_API_URL=
TRAE_API_MODEL=

# ---------- 腾讯云 COS(对象存储,用于图片持久化) ----------
# 留空则使用本地 uploads 目录;填入后切换到 COS 存储
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=danqing-ai-1250000000
COS_REGION=ap-hongkong
COS_BASE_URL=https://danqing-ai-1250000000.cos.ap-hongkong.myqcloud.com
